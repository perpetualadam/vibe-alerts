# =============================================================================
# VibeAlerts Environment Variables
# Copy to .env.local for local development. Set in Vercel for production.
# NEVER commit .env.local or expose server-only keys to the client.
# =============================================================================

# --- Public (safe for browser) ---
NEXT_PUBLIC_APP_URL=https://vibe-alerts.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@vibe-alerts.com
NEXT_PUBLIC_SUBSCRIPTION_PRICE_LABEL=$15/month
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Google Analytics 4 measurement ID (enables gtag on all pages)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Server-only (NEVER prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Free trial length for new subscriptions (days). Set to 0 to disable. Default: 14.
STRIPE_TRIAL_PERIOD_DAYS=14
NEXT_PUBLIC_SUBSCRIPTION_TRIAL_DAYS=14

# Optional: Upstash Redis for distributed rate limiting (required in production)
# Without these, in-memory rate limiting is used locally only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Logging: debug | info | warn | error (default: info in prod, debug in dev)
LOG_LEVEL=info

# Webhook security
# Max age of X-VibeAlerts-Timestamp in seconds (replay attack prevention)
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Global max payload size in bytes (default 64KB)
WEBHOOK_MAX_PAYLOAD_BYTES=65536

# --- Email (Resend) — platform operator only; enables Email channel for all tenants ---
# If the domain also uses Cloudflare Email Routing, keep ONE root SPF record:
#   v=spf1 include:_spf.mx.cloudflare.net include:resend.com ~all
# See docs/CLOUDFLARE.md → Email Routing. Verify with:
#   npm run verify:email-dns
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@yourdomain.com

# --- Credential encryption (required for per-tenant WhatsApp + Shopify tokens) ---
# Generate with: openssl rand -hex 32
# Used to AES-256-GCM encrypt customer access tokens at rest.
CREDENTIALS_ENCRYPTION_KEY=

# --- Shopify App (OAuth + automatic Admin webhooks) ---
# Create a custom app in the Shopify Partner Dashboard (or Dev Dashboard).
# App URL: {NEXT_PUBLIC_APP_URL}/install/shopify
# Allowed redirection URL: {NEXT_PUBLIC_APP_URL}/api/shopify/auth/callback
# See shopify.app.toml for Partner / CLI scaffolding.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated Admin API scopes (defaults cover orders, customers, checkouts)
# SHOPIFY_SCOPES=read_orders,read_customers,read_checkouts,read_merchant_managed_fulfillment_orders
# Optional API version override (default 2025-07)
# SHOPIFY_API_VERSION=2025-07

# --- WhatsApp Business Cloud API (Meta official) ---
# Multi-tenant: each customer connects their own WABA in the dashboard.
# Optional Graph API version override (default v21.0)
WHATSAPP_GRAPH_API_VERSION=v21.0

# Optional legacy platform-operator fallback (single shared number for all tenants).
# Prefer per-tenant connections via the dashboard Connect WhatsApp flow.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Slack, Discord, and Teams use per-tenant Incoming Webhook URLs (configured in dashboard).
# Telegram uses TELEGRAM_BOT_TOKEN above + per-tenant Chat ID.
